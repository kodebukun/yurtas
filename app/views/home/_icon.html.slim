.d-flex.justify-content-between.mb-3

  .d-flex.flex-column.w-25.mr-2.mr-md-4
    = link_to top_posts_path do
      .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius:10px; position:relative;"]
        - if @posts_unread.present?
          i.fas.fa-circle.index-circle
          i.far.fa-comment-dots.display-4[style="color:#00b8a9;"]
        - else
          i.far.fa-comment-dots.display-4[style="color:#00b8a9;"]
    .small.text-center.mt-1  掲示板
  
  .d-flex.flex-column.w-25.mr-2.mr-md-4
    = link_to wifis_path do
      .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius: 10px;"]
        i.fas.fa-wifi.display-4[style="color:#559af8;"]
    .small.text-center.mt-1  Wi-Fi

  .d-flex.flex-column.w-25.mr-2.mr-md-4
    = link_to top_incidents_path do
      .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius: 10px;"]
        i.fas.fa-exclamation-triangle.display-4[style="color:#f08a5d;"]
    .small.text-center.mt-1  インシデント
  
  .d-flex.flex-column.w-25.mr-2.mr-md-4
      = link_to top_procedures_path do
        .border.py-2.text-center.btn.btn-outline-light.w-100[style="border-radius: 10px; position:relative;"]
          - if @incidents_unread.present?
            i.fas.fa-circle.index-circle
            i.fas.fa-search.display-4[style="color:#ff69b4;"]
          - else
            i.fas.fa-search.display-4[style="color:#ff69b4;"]
      .small.text-center.mt-1  調べる

- if @current_user.staff?
  .d-flex.justify-content-between.mb-3

    .d-flex.flex-column.w-25.mr-2.mr-md-4
      = link_to menu_attendances_path do
        .border.py-2.text-center.btn.btn-outline-light.w-100[style="border-radius: 10px;"]
          i.fas.fa-building.display-4[style="color:#f6416c;"]
      .small.text-center.mt-1  当直
    
    .d-flex.flex-column.w-25.mr-2.mr-md-4
      = link_to anonymous_posts_path do
        .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius:10px; position:relative;"]
          - if @anonymous_unread.present?
            i.fas.fa-circle.index-circle
            i.far.fa-envelope.display-4[style="color:#6E6E6E;"]
          - else
            i.far.fa-envelope.display-4[style="color:#6E6E6E;"]
      .small.text-center.mt-1  Opinion Box

    .d-flex.flex-column.w-25.mr-2.mr-md-4
      
    .d-flex.flex-column.w-25.mr-2.mr-md-4
    

- if @current_user.id == 5 || @current_user.id == 13 || @current_user.id == 4 || @current_user.admin
  .text-info.mb-2 ◎拡張機能
  .d-flex.justify-content-between.mb-3

    .d-flex.flex-column.w-25.mr-2.mr-md-4
      = link_to new_attendances_path do
        .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius: 10px;"]
          i.fas.fa-address-book.display-4[style="color:#f6416c;"]
      .small.text-center.mt-1  当直表登録

    .d-flex.flex-column.w-25.mr-2.mr-md-4
      = link_to breaches_path do
        .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius:10px; position:relative;"]
          - if @breaches_unread.present?
            i.fas.fa-circle.index-circle.pl-4
            i.fas.fa-exclamation.display-4[style="color:#585858;"]
          - else
            i.fas.fa-exclamation.display-4[style="color:#585858;"]
      .small.text-center.mt-1  違反報告

    - if @current_user.admin
      .d-flex.flex-column.w-25.mr-2.mr-md-4
        = link_to page_views_path do
          .border.p-2.text-center.btn.btn-outline-light.w-100[style="border-radius: 10px;"]
            i.fas.fa-eye.display-4[style="color:#2196F3;"]
        .small.text-center.mt-1  閲覧履歴
    - else
      .w-25.mr-2.mr-md-4
    .w-25
